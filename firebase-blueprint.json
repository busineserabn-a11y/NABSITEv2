{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and company assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "SUB_ADMIN", "STAFF"] },
        "status": { "type": "string", "enum": ["active", "suspended", "disabled"] },
        "assignedCompanyId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "role", "status"]
    },
    "Company": {
      "title": "Company",
      "description": "Enterprise digital identity record and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["draft", "active", "published", "suspended", "archived"] },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 256 },
        "city": { "type": "string", "maxLength": 64 },
        "logo": { "type": "string", "maxLength": 2048 },
        "coverImage": { "type": "string", "maxLength": 2048 },
        "shortDescription": { "type": "string", "maxLength": 512 },
        "websiteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "category", "status"]
    },
    "Website": {
      "title": "Website",
      "description": "Full website layout, theme, navigation, pages, and components",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "templateId": { "type": "string", "maxLength": 128 },
        "themeId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "version": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Product or menu item belonging to a company",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "image": { "type": "string", "maxLength": 2048 },
        "isAvailable": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "price"]
    },
    "ProductCategory": {
      "title": "ProductCategory",
      "description": "Category for organizing company products/menu items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 },
        "order": { "type": "number" }
      },
      "required": ["id", "companyId", "name"]
    },
    "QrConfig": {
      "title": "QrConfig",
      "description": "Configured QR code branding, color, size, and destination",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "targetUrl": { "type": "string", "maxLength": 2048 },
        "title": { "type": "string", "maxLength": 128 },
        "frame": { "type": "string", "maxLength": 64 },
        "fgColor": { "type": "string", "maxLength": 32 },
        "bgColor": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "targetUrl"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Inquiry or contact submission from public website",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["new", "contacted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administrative action record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 2048 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Tracked page view or interaction metric",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "path": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "timestamp"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "description": "School academic year definition using Ethiopian or Gregorian calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "calendarType": { "type": "string", "enum": ["ETHIOPIAN", "GREGORIAN"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "isActive"]
    },
    "Grade": {
      "title": "Grade",
      "description": "School grade level",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "level": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Section": {
      "title": "Section",
      "description": "Classroom section under a specific grade",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "gradeId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "gradeId", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curriculum subject assigned to grades and sections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "maxScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Student directory profile with unique identifier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 128 },
        "admissionNo": { "type": "string", "maxLength": 64 },
        "gradeId": { "type": "string", "maxLength": 128 },
        "sectionId": { "type": "string", "maxLength": 128 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "graduated", "transferred", "inactive"] }
      },
      "required": ["id", "companyId", "fullName", "admissionNo", "gradeId", "sectionId"]
    },
    "Marklist": {
      "title": "Marklist",
      "description": "Assessment mark sheet by academic year, grade, section, and subject",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "gradeId": { "type": "string", "maxLength": 128 },
        "sectionId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "maxScore": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "submitted", "published"] }
      },
      "required": ["id", "companyId", "academicYearId", "gradeId", "sectionId", "subjectId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC credentials"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Enterprise directory and company settings"
    },
    "/websites/{websiteId}": {
      "schema": "Website",
      "description": "Website configurations, draft and published states"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products and digital menu offerings"
    },
    "/productCategories/{catId}": {
      "schema": "ProductCategory",
      "description": "Product categories by company"
    },
    "/qrConfigs/{qrId}": {
      "schema": "QrConfig",
      "description": "Saved QR codes and branding assets"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Public inquiries submitted through company pages"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail of mutations and administrative actions"
    },
    "/analyticsEvents/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Real analytics events and metrics"
    },
    "/academicYears/{yearId}": {
      "schema": "AcademicYear",
      "description": "School academic years and calendar configuration"
    },
    "/grades/{gradeId}": {
      "schema": "Grade",
      "description": "School grades"
    },
    "/sections/{sectionId}": {
      "schema": "Section",
      "description": "Class sections linked to grades"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Subjects mapped to grades and sections"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "School student roster"
    },
    "/marklists/{marklistId}": {
      "schema": "Marklist",
      "description": "Student marks and scores per class and subject"
    },
    "/settings/{settingDoc}": {
      "schema": { "$ref": "PlatformSettings" },
      "description": "Global platform configurations and feature registries"
    }
  }
}
