rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & roles
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isOwnerEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'abenezarofficial1@gmail.com' ||
        request.auth.token.email == 'busineser.abn@gmail.com' ||
        request.auth.token.email == 'owner@nabsite.io' ||
        request.auth.token.email == 'owner@nabsite.et'
      );
    }

    function isOwner() {
      return isOwnerEmail() || (getUserData() != null && getUserData().role == 'OWNER');
    }

    function isAdmin() {
      return isOwner() || (getUserData() != null && getUserData().role == 'ADMIN');
    }

    function isSubAdmin(companyId) {
      return isAdmin() || (
        getUserData() != null &&
        getUserData().role == 'SUB_ADMIN' &&
        (
          getUserData().assignedCompanyId == companyId ||
          (getUserData().assignedCompanyIds != null && companyId in getUserData().assignedCompanyIds)
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isOwner();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isOwner();
    }

    // Websites Collection
    match /websites/{websiteId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isOwner();
    }

    // Products & Menu Items
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Product Categories
    match /productCategories/{catId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // QR Configurations
    match /qrConfigs/{qrId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Offers & Specials
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Public Leads / Inquiries
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Audit Logs (Zero-Trust Immutable)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false; // Immutable audit logs
    }

    // Analytics Events
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Platform Settings & Showcase
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isOwner() || isSignedIn();
    }
  }
}
