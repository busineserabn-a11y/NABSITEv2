rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & roles
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isOwnerEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'abenezarofficial1@gmail.com' ||
        request.auth.token.email == 'busineser.abn@gmail.com' ||
        request.auth.token.email == 'owner@nabsite.io'
      );
    }

    function isOwner() {
      return isOwnerEmail() || (getUserData() != null && getUserData().role == 'OWNER');
    }

    function isAdmin() {
      return isOwner() || (getUserData() != null && (getUserData().role == 'ADMIN' || getUserData().role == 'OWNER'));
    }

    function isSubAdmin(companyId) {
      return isAdmin() || (
        getUserData() != null &&
        getUserData().role == 'SUB_ADMIN' &&
        (
          getUserData().assignedCompanyId == companyId ||
          (getUserData().assignedCompanyIds != null && companyId in getUserData().assignedCompanyIds)
        )
      );
    }

    // Users Collection - ONLY Owner can update permissionMatrix, role, or company assignments
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner() || isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isOwner() || (
        isSignedIn() && request.auth.uid == userId &&
        // Self updates cannot elevate role or change permissions
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissionMatrix', 'assignedCompanyIds', 'assignedCompanyId'])
      );
      allow delete: if isOwner();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Websites Collection
    match /websites/{websiteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Products & Menu Items
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Product Categories
    match /productCategories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // QR Configurations
    match /qrConfigs/{qrId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow write: if isSignedIn();
    }

    // Offers & Specials
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public Leads / Inquiries
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }

    // Audit Logs (Zero-Trust Immutable Audit Trail)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    // Analytics Events
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Platform Settings & Showcase
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Categories
    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Showcase
    match /showcase/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Themes & Features
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /features/{featureId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // School Academic Module: Academic Years, Grades, Sections, Subjects, Students, Marklists
    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /grades/{gradeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /marklists/{marklistId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /schoolAnnouncements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
